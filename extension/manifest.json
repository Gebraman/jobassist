{
  "manifest_version": 3,
  "name": "JobAssist AI Copilot & Multi-Client Studio",
  "version": "7.0.0",
  "description": "Enterprise Autonomous AI Reverse Recruitment Agency: Multi-Client AutoPilot, Pre-Flight ATS Compliance Auditor, Canva Resumes, and Interview Copilot.",
  "permissions": [
    "sidePanel",
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "downloads"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "JobAssist AI Studio (Side-by-Side)"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "clients.js",
        "resume_generator.js",
        "ai_answer_synthesizer.js",
        "recruiter_outreach.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
